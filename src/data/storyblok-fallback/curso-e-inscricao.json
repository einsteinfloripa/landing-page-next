          ],
          "titulo": "Vai se inscrever?",
          "component": "links-materiais-section",
          "descricao": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "attrs": {
                  "textAlign": null
                },
                "content": [
                  {
                    "text": "Não se esqueça de ver o material!",
                    "type": "text",
                    "marks": [
                      {
                        "type": "textStyle",
                        "attrs": {
                          "color": ""
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "_uid": "98452728-a1ac-4c79-9c2d-2d3e7d0a94cb",
          "duvidas": [
            {
              "_uid": "dc1c54e6-3174-46c9-8c20-8c38757f8389",
              "pergunta": "Apenas estudantes com baixa renda podem se inscrever?",
              "resposta": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "As vagas são prioritariamente destinadas a alunos de baixa renda, com renda familiar bruta per capita de até 1,5 salário mínimo.",
                        "type": "text"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "No entanto, caso ainda existam vagas remanescentes, também poderão ser aceitos candidatos com renda de até 3,5 salários mínimos, desde que atendam aos demais requisitos do edital e apresentem toda a documentação exigida.",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              "component": "duvida"
            },
            {
              "_uid": "35e123e8-1436-4658-816a-dc1c50c683d8",
              "pergunta": "Apenas maiores de idade podem se inscrever?",
              "resposta": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "Não! A idade mínima para inscrição é de 16 anos a partir da data de início do processo seletivo.",
                        "type": "text"
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "Mas, importante lembrar que é necessário ter cursado ou estar cursando em 2026 o TERCEIRO ano do ensino médio",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              "component": "duvida"
            },
            {
              "_uid": "fd55b17a-ea20-4db4-8391-c57c6e01b6c5",
              "pergunta": "Até quando vão as inscrições?",
              "resposta": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "Até dia 27 de fevereiro de 2026.",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              "component": "duvida"
            },
            {
              "_uid": "7d882957-548f-449f-86b4-318a330c995c",
              "pergunta": "As aulas são voltadas apenas para o vestibular da UFSC?",
              "resposta": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "Não! O Einstein Floripa oferece aulas e simulados com objetivo de preparar os alunos para os vestibulares UFSC, UDESC e ENEM.",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              "component": "duvida"
            },
            {
              "_uid": "e0081801-8dd3-4211-bbab-4f9f6dda555d",
              "pergunta": "Onde o cursinho acontece?",
              "resposta": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "As aulas e monitorias acontecem no Centro de Ciências de Saúde (CCS) da UFSC, de segunda a sexta das 18 até as 22 horas.",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              "component": "duvida"
            },
            {
              "_uid": "70401df1-01bb-424d-96d5-5c0880d387e1",
              "pergunta": "O processo seletivo é online?",
              "resposta": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "A inscrição para o processo seletivo e o envio de documentos é online, mas as etapas de prova e entrevista acontecem presencialmente na UFSC.",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              "component": "duvida"
            }
          ],
