          ],
          "titulo": "Vai se inscrever?",
          "component": "links-materiais-section",
          "descricao": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Estamos com o processo fechado no momento.",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Que tal se preparar lendo o edital do último processo?",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        },
        {
          "_uid": "17e7bb7e-36f7-4db1-ad4a-ea41de991c54",
          "duvidas": [
            {
              "_uid": "e3077aba-c223-49c8-a083-b54b3897b776",
              "pergunta": "Quem pode se candidatar para ser voluntário no Einstein?",
              "resposta": {
                "type": "doc",
                "attrs": {
                  "backgroundColor": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "Podem participar do nosso processo seletivo estudantes que estejam atualmente matriculados em cursos de graduação (seja licenciatura ou bacharelado) ou em programas de pós-graduação.",
                        "type": "text",
                        "marks": [
                          {
                            "type": "textStyle",
                            "attrs": {
                              "color": "#000000"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "component": "duvida"
            },
            {
              "_uid": "c809d4ac-d996-427f-9b3a-ffd4c964b59e",
              "pergunta": "Qual é a carga horária semanal exigida?",
              "resposta": {
                "type": "doc",
                "attrs": {
                  "backgroundColor": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "text": "A dedicação mínima exigida varia de acordo com a função escolhida:",
                        "type": "text",
