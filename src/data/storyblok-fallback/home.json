          "titulo": "Criando um futuro onde a educação é para todos",
          "component": "about-section",
          "descricao": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "O Einstein Floripa nasceu do sonho de três universitários em ",
                    "type": "text",
                    "marks": [
                      {
                        "type": "textStyle",
                        "attrs": {
                          "color": ""
                        }
                      }
                    ]
                  },
                  {
                    "text": "democratizar o acesso ao ensino superior ",
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      },
                      {
                        "type": "textStyle",
                        "attrs": {
                          "color": ""
                        }
                      }
                    ]
                  },
                  {
                    "text": "no Brasil. Ao se depararem com as dificuldades de muitos para alcançar uma ",
                    "type": "text",
                    "marks": [
                      {
                        "type": "textStyle",
                        "attrs": {
                          "color": ""
                        }
                      }
                    ]
                  },
                  {
                    "text": "educação de qualidade",
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      },
                      {
                        "type": "textStyle",
                        "attrs": {
                          "color": ""
                        }
                      }
                    ]
                  },
                  {
                    "text": ", decidiram agir e criaram este projeto ",
                    "type": "text",
                    "marks": [
                      {
                        "type": "textStyle",
                        "attrs": {
                          "color": ""
                        }
                      }
                    ]
                  },
                  {
                    "text": "voluntário e gratuito",
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      },
                      {
                        "type": "textStyle",
                        "attrs": {
                          "color": ""
                        }
                      }
                    ]
                  },
                  {
                    "text": ", que abre portas para um futuro melhor.",
                    "type": "text",
                    "marks": [
                      {
                        "type": "textStyle",
                        "attrs": {
                          "color": ""
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
