              "titulo": "Planejamento Conjunto",
              "component": "card-texto",
              "descricao": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Desenvolvemos ações personalizadas e estratégicas, alinhadas às necessidades específicas da sua empresa e ao impacto desejado.",
