              "titulo": "Implementação",
              "component": "card-texto",
              "descricao": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Colocamos em prática as ações planejadas, garantindo uma execução organizada, transparente e alinhada aos objetivos definidos previamente.",
                        "type": "text",
                        "marks": [
                          {
                            "type": "textStyle",
                            "attrs": {
                              "color": ""
                            }
                          }
